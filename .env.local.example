# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local and NEVER put the Supabase service_role key here.
# ---------------------------------------------------------------------------

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use whichever key your project issues: the publishable key (sb_publishable_...)
# or the legacy anon public key. Both are public and protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public site URL (used for canonical URLs, sitemap and Open Graph tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: display name of the person behind the portfolio
NEXT_PUBLIC_SITE_OWNER=Most. Farheen Islam Badhon
